# Use roots that expand to absolute paths. Keep raw data outside the project.
DATASET_ROOT="${HOME}/datasets/DeepfakeDataset"
FFPP_ROOT="${DATASET_ROOT}/FaceForensics++"
CELEB_DF_V1_ROOT="${DATASET_ROOT}/Celeb-DF-v1"
CELEB_DF_V2_ROOT="${DATASET_ROOT}/Celeb-DF-v2"
DFDC_ROOT="${DATASET_ROOT}/DFDC"
DFDCP_ROOT="${DATASET_ROOT}/DFDCP"
UADFV_ROOT="${DATASET_ROOT}/UADFV"
WILDDEEPFAKE_ROOT="${DATASET_ROOT}/wild_deepfake_test"
UFD_ROOT="${DATASET_ROOT}/UniversalFakeDetect"
TINY_GENIMAGE_ROOT="${DATASET_ROOT}/Tiny-GenImage/data"
# These roots point directly to directories containing Parquet shards.
OPENFAKE_V1_ROOT="${DATASET_ROOT}/OpenFake/OpenFake_v1_test/data"
OPENFAKE_V2_ROOT="${DATASET_ROOT}/OpenFake/OpenFake_test/data"
OPENFAKE_ROOT="${DATASET_ROOT}/OpenFake/OpenFake_combined/data"
MANIFEST_ROOT="${HOME}/.local/share/lightning-remake/manifests"

# Shared pretrained assets (Xception/EfficientNet/ForAda), never model code.
WEIGHT_ROOT="${HOME}/weights/lightning-remake"
