#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
staged_files=()
partial_files=()
while IFS= read -r -d '' path; do
    if git diff --quiet -- "$path"; then
        staged_files+=("$path")
    else
        partial_files+=("$path")
    fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.py' '*.pyi')

if (( ${#staged_files[@]} )); then
    result=0
    uv run --locked ruff check --fix --force-exclude -- "${staged_files[@]}" || result=$?
    if ! git diff --quiet -- "${staged_files[@]}"; then
        printf '%s\n' 'Ruff applied fixes. Review and stage them before retrying the commit.' >&2
        exit 1
    fi
    if (( result != 0 )); then
        exit "$result"
    fi
fi

for path in "${partial_files[@]}"; do
    printf 'Checking staged content of %s\n' "$path"
    git show ":$path" | uv run --locked ruff check --force-exclude --stdin-filename "$path" -
done
